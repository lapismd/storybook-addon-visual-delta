{
  "name": "storybook-addon-visual-delta",
  "version": "0.1.5",
  "private": true,
  "description": "Local Visual Delta Storybook addon (reimplemented from npm storybook-addon-visual-delta@0.1.5). Overlay / heatmap diff against baseline images.",
  "keywords": [
    "storybook-addon",
    "visual",
    "overlay",
    "diff"
  ],
  "license": "MIT",
  "author": "houjinlong <1844041598@qq.com>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./preview": "./src/preview.ts",
    "./preset": "./src/preset.ts",
    "./manager": "./src/manager.tsx",
    "./visual-capture": "./src/shared/visual-capture-step.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*",
    "README.md",
    "VENDOR.md",
    "LICENSE"
  ],
  "dependencies": {
    "@storybook/icons": "^2.1.0",
    "html-to-image": "^1.11.13",
    "pixelmatch": "^7.1.0"
  },
  "peerDependencies": {
    "react": "*",
    "storybook": "*"
  },
  "storybook": {
    "displayName": "Visual Delta",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact",
      "react-native"
    ]
  }
