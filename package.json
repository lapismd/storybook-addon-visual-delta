{
  "name": "@lapismd/storybook-addon-visual-delta",
  "version": "0.0.5",
  "description": "Local-first visual regression testing for Storybook with Playwright baselines, pixel diffs, and in-Storybook review.",
  "keywords": [
    "storybook",
    "storybook-addon",
    "visual-regression",
    "visual-testing",
    "screenshot-testing",
    "playwright",
    "pixel-diff",
    "baseline"
  ],
  "license": "MIT",
  "author": "Steve Juma<help@lapis.md>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lapismd/storybook-addon-visual-delta.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "visual-delta": "./dist/node/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./preview": "./src/preview.ts",
    "./preset": "./src/preset.ts",
    "./manager": "./src/manager.tsx",
    "./visual-capture": "./src/shared/visual-capture-step.ts",
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js",
      "default": "./dist/playwright/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js",
      "default": "./dist/runner/index.js"
    },
    "./src/*": "./src/*",
    "./src/stories/*": "./src/stories/*",
    "./src/stories/panel-fixtures": "./src/stories/panel-fixtures.tsx",
    "./src/stories/DiffResultFixture": "./src/stories/DiffResultFixture.tsx",
    "./src/stories/PanelShell": "./src/stories/PanelShell.tsx",
    "./src/stories/TestingModuleShell": "./src/stories/TestingModuleShell.tsx",
    "./src/stories/mock-visual-backend": "./src/stories/mock-visual-backend.ts",
    "./src/shared/*": "./src/shared/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*",
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:node": "tsc -p tsconfig.node-build.json && node ./scripts/prepare-cli-bin.mjs",
    "visual-delta:self": "pnpm build:node && node ./dist/node/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node-build.json --noEmit",
    "prepare": "pnpm build:node",
    "prepack": "pnpm build:node",
    "storybook": "node ./scripts/run-storybook.mjs",
    "storybook:ci": "node ./scripts/run-storybook.mjs --ci",
    "build-storybook": "node -e \"require('node:fs').mkdirSync('.visual-delta/cache',{recursive:true})\" && storybook build --stats-json .visual-delta/cache -o storybook-static",
    "examples:baselines": "node ./scripts/generate-example-baselines.mjs",
    "examples:baselines:capture": "pnpm build:node && node ./scripts/capture-example-baselines.mjs",
    "test": "vitest run",
    "test:panel": "playwright test -c playwright.panel.config.ts",
    "test:manager": "playwright test -c playwright.manager.config.ts",
    "test:browsers": "node ./scripts/test-browser-matrix.mjs",
    "ci:image:check": "node ./scripts/check-ci-image.mjs",
    "spec:lint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc",
    "spec:validate": "node ./scripts/check-spec-structure.mjs",
    "spec:build": "mdbook build ./spec",
    "spec:serve": "mdbook serve ./spec --open",
    "spec:test": "node --test ./scripts/*.spec.mjs",
    "spec:first": "node ./scripts/check-spec-first.mjs",
    "spec:check": "pnpm spec:lint && pnpm spec:validate && pnpm spec:build && pnpm spec:test && pnpm ci:image:check && pnpm spec:first",
    "release:check": "node ./scripts/check-npm-release.mjs",
    "release:verify-provenance": "node ./scripts/verify-npm-provenance.mjs"
  },
  "dependencies": {
    "@storybook/icons": "^2.1.0",
    "html-to-image": "^1.11.13",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/addon-docs": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "mermaid": "^11.16.0",
    "playwright": "1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "storybook": "10.5.2",
    "svelte": "^5.56.1",
    "typescript": "^7.0.2",
    "vite": "^6.2.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "playwright": "*",
    "react": "*",
    "storybook": "*",
    "svelte": "^5.0.0",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "storybook": {
    "displayName": "Visual Delta",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact",
      "react-native"
    ]
  }
}
