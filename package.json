{
  "name": "@lapismd/storybook-addon-visual-delta",
  "version": "0.0.6",
  "description": "Local-first visual regression testing for Storybook with Playwright baselines, pixel diffs, and in-Storybook review.",
  "keywords": [
    "storybook",
    "storybook-addon",
    "visual-regression",
    "visual-testing",
    "screenshot-testing",
    "playwright",
    "pixel-diff",
    "baseline"
  ],
  "license": "MIT",
  "author": "Steve Juma<help@lapis.md>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/storybook-addon-visual-delta.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "visual-delta": "./dist/node/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./preview": "./src/preview.ts",
    "./preset": "./src/preset.ts",
    "./manager": "./src/manager.tsx",
    "./visual-capture": "./src/shared/visual-capture-step.ts",
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "deno": "./dist/playwright/index.js",
      "node": "./dist/playwright/index.js",
      "import": "./dist/playwright/index.js",
      "default": "./dist/playwright/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "deno": "./dist/node/index.js",
      "node": "./dist/node/index.js",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "deno": "./dist/runner/index.js",
      "node": "./dist/runner/index.js",
      "import": "./dist/runner/index.js",
      "default": "./dist/runner/index.js"
    },
    "./src/*": "./src/*",
    "./src/stories/*": "./src/stories/*",
    "./src/stories/panel-fixtures": "./src/stories/panel-fixtures.tsx",
    "./src/stories/DiffResultFixture": "./src/stories/DiffResultFixture.tsx",
    "./src/stories/PanelShell": "./src/stories/PanelShell.tsx",
    "./src/stories/TestingModuleShell": "./src/stories/TestingModuleShell.tsx",
    "./src/stories/mock-visual-backend": "./src/stories/mock-visual-backend.ts",
    "./src/shared/*": "./src/shared/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*",
    "dist/**/*",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "deno task build",
    "build:node": "deno task build:node",
    "visual-delta:self": "deno task visual-delta:self",
    "typecheck": "deno task typecheck",
    "prepare": "deno task build:node",
    "prepack": "deno task build:node",
    "storybook": "deno task storybook",
    "storybook:ci": "deno task storybook:ci",
    "build-storybook": "deno task build-storybook",
    "playwright:install": "deno task playwright:install",
    "examples:baselines": "deno task examples:baselines",
    "examples:baselines:capture": "deno task examples:baselines:capture",
    "test": "deno task test",
    "test:scripts": "deno task test:scripts",
    "test:panel": "deno task test:panel",
    "test:manager": "deno task test:manager",
    "test:browsers": "deno task test:browsers",
    "changeset": "deno task changeset",
    "ci:image:check": "deno task ci:image:check",
    "spec:lint": "deno task spec:lint",
    "spec:validate": "deno task spec:validate",
    "spec:build": "deno task spec:build",
    "spec:serve": "deno task spec:serve",
    "spec:first": "deno task spec:first",
    "spec:check": "deno task spec:check",
    "publint": "deno task publint",
    "audit:dependencies": "deno task audit:dependencies",
    "check": "deno task check",
    "release:check": "deno task release:check",
    "release:intent": "deno task release:intent",
    "release:tag": "deno task release:tag",
    "release:version": "deno task release:version",
    "release:verify-provenance": "deno task release:verify-provenance"
  },
  "engines": {
    "deno": "2.9.5"
  },
  "dependencies": {
    "@storybook/icons": "^2.1.0",
    "html-to-image": "^1.11.13",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/addon-docs": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "mermaid": "^11.16.0",
    "playwright": "1.61.1",
    "publint": "^0.3.24",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "storybook": "10.5.2",
    "svelte": "^5.56.1",
    "typescript": "^7.0.2",
    "vite": "^6.2.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "playwright": "*",
    "react": "*",
    "storybook": "*",
    "svelte": "^5.0.0",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "storybook": {
    "displayName": "Visual Delta",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact",
      "react-native"
    ]
  }
}
