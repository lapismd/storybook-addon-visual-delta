{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/constants.ts",
    "src/visual-diff-sidecar.ts",
    "src/shared/capture-subject-types.ts",
    "src/shared/interaction-capture.ts",
    "src/shared/modes.ts",
    "src/shared/ignore.ts",
    "src/shared/config-types.ts",
    "src/shared/capture-params-attrs.ts",
    "src/node/**/*.ts",
    "src/playwright/**/*.ts"
  ],
  "exclude": ["src/**/*.spec.ts"]
}
