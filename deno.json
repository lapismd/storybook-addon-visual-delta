{
  "name": "@lapismd/storybook-addon-visual-delta",
  "version": "0.0.6",
  "exports": {
    ".": "./src/index.ts",
    "./preview": "./src/preview.ts",
    "./preset": "./src/preset.ts",
    "./manager": "./src/manager.tsx",
    "./visual-capture": "./src/shared/visual-capture-step.ts",
    "./playwright": "./dist/playwright/index.js",
    "./node": "./dist/node/index.js",
    "./runner": "./dist/runner/index.js"
  },
  "nodeModulesDir": "manual",
  "nodeModulesLinker": "isolated",
  "links": [
    "../spec-validator",
    "../spec-validator/packages/workspace-tools"
  ],
  "allowScripts": ["npm:esbuild"],
  "fmt": {
    "proseWrap": "preserve"
  },
  "tasks": {
    "version:check": "deno run --no-prompt ./scripts/check-deno-version.ts",
    "install": "deno task version:check && deno install --frozen=false",
    "ci": "deno task version:check && deno ci",
    "ci:bootstrap": "deno run --no-prompt --allow-read --allow-write=.. --allow-run=git,deno --allow-net=github.com ./scripts/bootstrap-siblings.ts",
    "ci:install": "deno task ci:bootstrap && deno task ci && deno task workspace:sync",
    "workspace:check": "deno run --no-prompt --allow-read ../spec-validator/packages/workspace-tools/src/cli.ts links check",
    "workspace:sync": "deno run --no-prompt --allow-read --allow-write ../spec-validator/packages/workspace-tools/src/cli.ts links sync",
    "build": "deno task build:node",
    "build:node": "deno task version:check && tsc -p tsconfig.node-build.json && deno run --no-prompt --allow-read=./dist --allow-write=./dist ./scripts/prepare-cli-bin.ts",
    "visual-delta:self": "deno task build:node && deno run -A ./dist/node/cli.js",
    "typecheck": "deno task version:check && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node-build.json --noEmit",
    "storybook": "deno run --no-prompt --allow-env --allow-read --allow-run=node ./scripts/run-storybook.ts",
    "storybook:ci": "deno run --no-prompt --allow-env --allow-read --allow-run=node ./scripts/run-storybook.ts --ci",
    "build-storybook": "deno eval 'Deno.mkdirSync(\".visual-delta/cache\", { recursive: true })' && node ./node_modules/storybook/dist/bin/dispatcher.js build --stats-json .visual-delta/cache -o storybook-static",
    "playwright:install": "node ./node_modules/playwright/cli.js install chromium firefox webkit",
    "examples:baselines": "deno run -A ./scripts/generate-example-baselines.mjs",
    "examples:baselines:capture": "deno task build:node && deno run -A ./scripts/capture-example-baselines.mjs",
    "test": "vitest run",
    "test:scripts": "deno test -A ./scripts/audit-dependencies.spec.ts ./scripts/capture-example-baselines.spec.mjs ./scripts/check-ci-image.spec.mjs ./scripts/check-npm-release.spec.mjs ./scripts/check-release-intent.spec.mjs ./scripts/ensure-release-tag.spec.mjs ./scripts/package-storybook-build.spec.mjs ./scripts/prepare-cli-bin.spec.mjs ./scripts/verify-npm-provenance.spec.mjs",
    "test:panel": "node ./node_modules/playwright/cli.js test -c playwright.panel.config.ts",
    "test:manager": "node ./node_modules/playwright/cli.js test -c playwright.manager.config.ts",
    "test:browsers": "deno run -A ./scripts/test-browser-matrix.mjs",
    "changeset": "changeset",
    "ci:image:check": "deno run -A ./scripts/check-ci-image.mjs",
    "spec:lint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc",
    "spec:validate": "spec-validator validate",
    "spec:build": "spec-validator build",
    "spec:serve": "spec-validator serve",
    "spec:first": "spec-validator first",
    "spec:check": "spec-validator check",
    "audit:runtime": "deno run --no-prompt --allow-read ./scripts/check-runtime-boundaries.ts",
    "audit:dependencies": "deno run --no-prompt --allow-read=./deno.lock --allow-net=api.osv.dev ./scripts/audit-dependencies.ts",
    "publint": "deno task build:node && publint",
    "check": "deno task typecheck && deno task audit:runtime && deno task test && deno task spec:check && deno task publint",
    "release:check": "deno run -A ./scripts/check-npm-release.mjs",
    "release:intent": "deno run -A ./scripts/check-release-intent.mjs",
    "release:tag": "deno run -A ./scripts/ensure-release-tag.mjs",
    "release:version": "changeset version && deno install --frozen=false --lockfile-only",
    "release:verify-provenance": "deno run -A ./scripts/verify-npm-provenance.mjs"
  }
}
